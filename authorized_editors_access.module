<?php

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_node_access().
 */
function authorized_editors_access_node_access(NodeInterface $node, $op, AccountInterface $account) {
  // Only alter update access.
  if ($op !== 'update') {
    return AccessResult::neutral();
  }

  // Administrators or users with the normal bypass permission should not be
  // restricted by this custom logic.
  if ($account->hasPermission('bypass node access')) {
    return AccessResult::allowed()->cachePerUser();
  }

  // Only apply this rule when the field exists on the node type.
  if (!$node->hasField('field_authorized_editors')) {
    return AccessResult::neutral()->addCacheableDependency($node);
  }

  $field = $node->get('field_authorized_editors');

  // If no authorized editors are set, do not override normal Drupal access.
  if ($field->isEmpty()) {
    return AccessResult::neutral()->addCacheableDependency($node);
  }

  // Safely load referenced user entities instead of reading raw target_id array
  // values, which avoids undefined array key warnings.
  $authorized_users = $field->referencedEntities();

  if (empty($authorized_users)) {
    return AccessResult::neutral()
      ->cachePerUser()
      ->addCacheableDependency($node);
  }

  $authorized_editor_ids = array_map(
    static fn($user) => (int) $user->id(),
    $authorized_users
  );

  $current_user_id = (int) $account->id();

  $is_authorized_editor = in_array($current_user_id, $authorized_editor_ids, TRUE);

  if ($is_authorized_editor) {
    return AccessResult::allowed()
      ->cachePerUser()
      ->addCacheableDependency($node);
  }

  // If this field is intended to explicitly control who may edit, forbid access
  // when the current user is not listed.
  return AccessResult::forbidden()
    ->cachePerUser()
    ->addCacheableDependency($node);
}